---
import { Image } from 'astro:assets';
import '../components/styles.astro/global.css';
import appStoreBadge from '../assets/app-store-apple-logo.svg';
import googlePlayBadge from '../assets/google-play-badge-logo1.svg';
import heroPhoneMockup from '../assets/iphone-15-pro-max-hand-mockup.png';
import savioHeroImage from '../assets/ab savio img.png';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="About Savio" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>About Savio</title>
  </head>
  <body>
    <div class="savio-page">
      <header class="hero-shell">
        <div class="hero-frame">
          <svg class="card-grid-overlay" viewBox="0 0 1408 640" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <defs>
              <mask id="hero-grid-mask" maskUnits="userSpaceOnUse">
                <rect width="1408" height="640" fill="black"/>
                <path d="M0 0 L0 640 M64 0 L64 640 M128 0 L128 640 M192 0 L192 640 M256 0 L256 640 M320 0 L320 640 M384 0 L384 640 M448 0 L448 640 M512 0 L512 640 M576 0 L576 640 M640 0 L640 640 M704 0 L704 640 M768 0 L768 640 M832 0 L832 640 M896 0 L896 640 M960 0 L960 640 M1024 0 L1024 640 M1088 0 L1088 640 M1152 0 L1152 640 M1216 0 L1216 640 M1280 0 L1280 640 M1344 0 L1344 640 M1408 0 L1408 640 M0 0 L1408 0 M0 64 L1408 64 M0 128 L1408 128 M0 192 L1408 192 M0 256 L1408 256 M0 320 L1408 320 M0 384 L1408 384 M0 448 L1408 448 M0 512 L1408 512 M0 576 L1408 576 M0 640 L1408 640" stroke="white" stroke-opacity="0.2" stroke-width="1.5" fill="none"/>
              </mask>
              <filter id="hero-soft-blur" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="225"/>
              </filter>
              <clipPath id="hero-grid-clip">
                <rect width="1408" height="640" rx="24"/>
              </clipPath>
            </defs>
            <g clip-path="url(#hero-grid-clip)">
              <g mask="url(#hero-grid-mask)">
                <ellipse cx="920" cy="330" rx="360" ry="250" fill="#FF4800" filter="url(#hero-soft-blur)"/>
              </g>
            </g>
          </svg>

          <nav class="floating-nav navbar" aria-label="Main navigation">
            <a href="/" class="nav-logo" aria-label="Savio home">
              <img src="/savio-logo.svg" alt="Savio logo" />
            </a>

            <div class="nav-links-desktop">
              <a href="#features">Features</a>
              <a href="#how-it-works">How it works</a>
              <a href="#app">App</a>
              <a href="#testimonials">Testimonials</a>
            </div>

            <button class="signup-btn signup-btn-desktop" type="button">Signup</button>

            <button class="hamburger-btn" type="button" aria-label="Open menu" aria-expanded="false">
              <span></span>
              <span></span>
              <span></span>
            </button>

            <div class="mobile-menu" hidden>
              <a href="#features">Features</a>
              <a href="#how-it-works">How it works</a>
              <a href="#app">App</a>
              <a href="#testimonials">Testimonials</a>
              <button class="signup-btn-mobile" type="button">Signup</button>
            </div>
          </nav>

          <div class="hero-content">
            <div class="hero-copy">
              <span class="eyebrow">ABOUT SAVIO</span>
              <h1>Why we built <span class="accent">Savio.</span></h1>
              <p>
                Reels in Instagram, videos on YouTube, threads in X, links in a dozen notes — all bookmarked with the best intentions, none of them ever seen again. So we built a calmer way.
              </p>

              <div class="app-badges" aria-label="Download app badges">
                <Image src={appStoreBadge} alt="Download on the App Store" width={161} height={48} class="store-badge" />
                <Image src={googlePlayBadge} alt="Get it on Google Play" width={161} height={48} class="store-badge" />
              </div>
            </div>

            <div class="hero-visual" aria-label="Savio app preview">
              <Image src={savioHeroImage} alt="Savio app preview" class="hero-phone-mockup" />
            </div>
          </div>
        </div>
      </header>

      <main>
        <section class="section product-section" id="features">
          <div class="section-inner product-inner">
            <div class="product-copy">
              <span class="eyebrow eyebrow-dark">THE PRODUCT</span>
              <h2>What is Savio?</h2>
              <p>
                Savio captures the things you save from the internet, organizes them instantly, and keeps them easy to find when you need them again.
              </p>
              <p>
                Instead of scattered bookmarks, notes, and screenshots, everything lives in one place with searchable collections, durable previews, and one-tap sharing.
              </p>
            </div>

            <div class="feature-grid" aria-label="Savio features grid">
              <div class="feature-cell cell-one">
                <div class="icon-wrap">
                  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M18.7522 11.1748L12.2958 6.87046C11.779 6.52566 11.0827 6.86961 11.0425 7.48958C11.0413 7.50736 11.0408 7.52518 11.0408 7.54301V16.1516C11.0399 16.7729 11.7118 17.1622 12.2503 16.8524C12.2658 16.8435 12.2809 16.8341 12.2958 16.8242L18.7522 12.5199C19.2335 12.2006 19.2335 11.494 18.7522 11.1748ZM12.6549 14.6438V9.05086L16.8489 11.8473L12.6549 14.6438ZM25.8369 2.43164H2.16315C1.12312 2.43164 0.28001 3.27475 0.28001 4.31477V19.3799C0.28001 20.4199 1.12308 21.2631 2.16315 21.263H25.8369C26.8769 21.263 27.72 20.4199 27.72 19.3799V4.31477C27.72 3.27475 26.8769 2.43164 25.8369 2.43164ZM26.1059 19.3799C26.1059 19.5284 25.9854 19.6489 25.8369 19.6489H2.16315C2.01457 19.6489 1.89412 19.5285 1.89412 19.3799V4.31477C1.89412 4.1662 2.01457 4.04574 2.16315 4.04575H25.8369C25.9854 4.04576 26.1059 4.16621 26.1059 4.31477V19.3799ZM27.72 24.7603C27.72 25.206 27.3587 25.5673 26.913 25.5673H1.08707C0.465794 25.5673 0.0775021 24.8948 0.388138 24.3567C0.532305 24.107 0.798732 23.9532 1.08707 23.9532H26.913C27.3587 23.9532 27.72 24.3145 27.72 24.7603Z" fill="#FF4800"/>
</svg>
                </div>
                <h3>One-tap capture</h3>
                <p>From 8+ apps plus any URL</p>
              </div>

              <div class="feature-cell cell-two">
                <div class="icon-wrap">
                  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M25.8692 8.04859L18.3366 0.516039C18.1854 0.364642 17.9803 0.279483 17.7663 0.279297H4.85337C3.81335 0.279297 2.97024 1.1224 2.97024 2.16243V11.8471C2.97024 12.4684 3.64279 12.8567 4.18082 12.5461C4.43053 12.4019 4.58435 12.1355 4.58435 11.8471V2.16244C4.58435 2.01385 4.7048 1.89341 4.85337 1.89341H16.9593V8.6189C16.9593 9.06464 17.3206 9.42597 17.7663 9.42597H24.4918V25.8362C24.4918 25.9847 24.3714 26.1052 24.2228 26.1052H23.1467C22.5254 26.1052 22.1371 26.7777 22.4478 27.3158C22.5919 27.5655 22.8584 27.7193 23.1467 27.7193H24.2228C25.2628 27.7193 26.1059 26.8762 26.1059 25.8362V8.6189C26.1057 8.40493 26.0206 8.19979 25.8692 8.04859ZM18.5734 3.03406L23.3512 7.81184H18.5734V3.03406ZM18.1577 16.5214C17.9011 16.3791 17.5874 16.3873 17.3386 16.5429L14.2691 18.461V18.3036C14.2691 17.2636 13.426 16.4205 12.3859 16.4205H3.7773C2.73727 16.4205 1.89417 17.2636 1.89417 18.3036V24.7601C1.89417 25.8001 2.73727 26.6432 3.7773 26.6432H12.3859C13.426 26.6432 14.2691 25.8001 14.2691 24.7601V24.6027L17.3386 26.5208C17.8654 26.8501 18.5511 26.4856 18.5729 25.8647C18.5732 25.8552 18.5734 25.8457 18.5734 25.8362V17.2275C18.5735 16.9341 18.4144 16.6637 18.1577 16.5214ZM12.6549 24.7601C12.6549 24.9087 12.5345 25.0291 12.3859 25.0291H3.7773C3.62872 25.0291 3.50828 24.9087 3.50828 24.7601V18.3036C3.50828 18.155 3.62872 18.0346 3.7773 18.0346H12.3859C12.5345 18.0346 12.6549 18.155 12.6549 18.3036V24.7601ZM16.9593 24.3794L14.2691 22.698V20.3656L16.9593 18.6843V24.3794Z" fill="#FF4800"/>
</svg>
                </div>
                <h3>Auto-organized</h3>
                <p>Searchable collections, no manual work</p>
              </div>

              <div class="feature-cell cell-three">
                <div class="icon-wrap">
                  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M24.7608 2.43266H21.2635V1.08755C21.2635 0.466283 20.591 0.0779904 20.0529 0.388626C19.8032 0.532793 19.6494 0.79922 19.6494 1.08755V2.43266H8.35059V1.08755C8.35059 0.466283 7.67804 0.0779904 7.14 0.388626C6.8903 0.532793 6.73648 0.79922 6.73648 1.08755V2.43266H3.23922C2.1992 2.43266 1.35608 3.27577 1.35608 4.31579V25.8374C1.35608 26.8774 2.1992 27.7205 3.23922 27.7205H24.7608C25.8008 27.7205 26.6439 26.8774 26.6439 25.8374V4.31579C26.6439 3.27577 25.8008 2.43266 24.7608 2.43266ZM3.23922 4.04677H6.73648V5.39187C6.73648 6.01315 7.40902 6.40144 7.94706 6.0908C8.19676 5.94664 8.35059 5.6802 8.35059 5.39187V4.04677H19.6494V5.39187C19.6494 6.01315 20.322 6.40144 20.86 6.0908C21.1097 5.94664 21.2635 5.6802 21.2635 5.39187V4.04677H24.7608C24.9094 4.04678 25.0298 4.16723 25.0298 4.31579V8.88912H2.9702V4.31579C2.9702 4.16722 3.09064 4.04676 3.23922 4.04677ZM24.7608 26.1064H3.23922C3.09064 26.1064 2.9702 25.9859 2.9702 25.8374V10.5032H25.0298V25.8374C25.0298 25.9859 24.9094 26.1064 24.7608 26.1064ZM19.4127 14.5063C19.7274 14.8213 19.7274 15.3318 19.4127 15.6469L12.9562 22.1034C12.6411 22.4181 12.1307 22.4181 11.8156 22.1034L8.58733 18.8751C8.16379 18.4206 8.3911 17.678 8.9965 17.5385C9.25775 17.4783 9.53184 17.5517 9.72797 17.7345L12.3859 20.3911L18.272 14.5063C18.5871 14.1916 19.0976 14.1916 19.4127 14.5063Z" fill="#FF4800"/>
</svg>
                </div>
                <h3>Durable previews</h3>
                <p>Still work when the original vanishes</p>
              </div>

              <div class="feature-cell cell-four">
                <div class="icon-wrap">
                  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
<g clip-path="url(#clip0_1046_6159)">
<path d="M22.75 14.5127V12.25H21V14.875C21 15.107 21.0923 15.3296 21.2564 15.4936L23.625 17.8623V19.25H4.375V17.8623L6.74362 15.4936C6.90773 15.3296 6.99995 15.107 7 14.875V11.375C6.99775 10.1455 7.31995 8.93722 7.93407 7.8721C8.54819 6.80698 9.43248 5.92277 10.4977 5.30874C11.5628 4.69471 12.7712 4.37262 14.0006 4.37498C15.2301 4.37734 16.4372 4.70407 17.5 5.32219V3.36586C16.6671 2.9971 15.7812 2.76207 14.875 2.66945V0.875H13.125V2.66945C10.9678 2.88893 8.96868 3.90047 7.51409 5.50847C6.0595 7.11647 5.25281 9.20671 5.25 11.375V14.5127L2.88137 16.8814C2.71727 17.0454 2.62505 17.268 2.625 17.5V20.125C2.625 20.3571 2.71719 20.5796 2.88128 20.7437C3.04538 20.9078 3.26794 21 3.5 21H9.625V21.875C9.625 23.0353 10.0859 24.1481 10.9064 24.9686C11.7269 25.7891 12.8397 26.25 14 26.25C15.1603 26.25 16.2731 25.7891 17.0936 24.9686C17.9141 24.1481 18.375 23.0353 18.375 21.875V21H24.5C24.7321 21 24.9546 20.9078 25.1187 20.7437C25.2828 20.5796 25.375 20.3571 25.375 20.125V17.5C25.375 17.268 25.2827 17.0454 25.1186 16.8814L22.75 14.5127ZM16.625 21.875C16.625 22.5712 16.3484 23.2389 15.8562 23.7312C15.3639 24.2234 14.6962 24.5 14 24.5C13.3038 24.5 12.6361 24.2234 12.1438 23.7312C11.6516 23.2389 11.375 22.5712 11.375 21.875V21H16.625V21.875Z" fill="#FF4800"/>
<path d="M19.25 7C19.25 7.92826 19.6187 8.8185 20.2751 9.47487C20.9315 10.1313 21.8217 10.5 22.75 10.5C23.6783 10.5 24.5685 10.1313 25.2249 9.47487C25.8813 8.8185 26.25 7.92826 26.25 7C26.25 6.07174 25.8813 5.1815 25.2249 4.52513C24.5685 3.86875 23.6783 3.5 22.75 3.5C21.8217 3.5 20.9315 3.86875 20.2751 4.52513C19.6187 5.1815 19.25 6.07174 19.25 7Z" fill="#FF4800"/>
</g>
<defs>
<clipPath id="clip0_1046_6159">
<rect width="28" height="28" fill="white"/>
</clipPath>
</defs>
</svg>
                </div>
                <h3>Shared collections</h3>
                <p>Collaborate with friends</p>
              </div>
            </div>
          </div>
        </section>

        <section class="section reason-section" id="how-it-works">
          <div class="reason-card">
            <svg class="card-grid-overlay" viewBox="0 0 1280 661" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <defs>
                <mask id="reason-grid-mask" maskUnits="userSpaceOnUse">
                  <rect width="1280" height="661" fill="black"/>
                  <path d="M0 0 L0 661 M64 0 L64 661 M128 0 L128 661 M192 0 L192 661 M256 0 L256 661 M320 0 L320 661 M384 0 L384 661 M448 0 L448 661 M512 0 L512 661 M576 0 L576 661 M640 0 L640 661 M704 0 L704 661 M768 0 L768 661 M832 0 L832 661 M896 0 L896 661 M960 0 L960 661 M1024 0 L1024 661 M1088 0 L1088 661 M1152 0 L1152 661 M1216 0 L1216 661 M1280 0 L1280 661 M0 0 L1280 0 M0 64 L1280 64 M0 128 L1280 128 M0 192 L1280 192 M0 256 L1280 256 M0 320 L1280 320 M0 384 L1280 384 M0 448 L1280 448 M0 512 L1280 512 M0 576 L1280 576 M0 640 L1280 640 M0 661 L1280 661" stroke="white" stroke-opacity="0.2" stroke-width="1.5" fill="none"/>
                </mask>
                <filter id="reason-soft-blur" x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="225"/>
                </filter>
                <clipPath id="reason-grid-clip">
                  <rect width="1280" height="661" rx="24"/>
                </clipPath>
              </defs>
              <g clip-path="url(#reason-grid-clip)">
                <g mask="url(#reason-grid-mask)">
                  <ellipse cx="880" cy="150" rx="280" ry="220" fill="#FFFFFF" filter="url(#reason-soft-blur)"/>
                </g>
              </g>
            </svg>

            <div class="reason-copy">
              <div class="reason-header">
                <span class="eyebrow">THE REASON</span>
                <h2>Why does Savio exist?</h2>
              </div>

              <ol class="reason-list">
                <li>
                  <span class="reason-number">1.</span>
                  <span class="reason-text">
                    Because saving is a promise to your future self that most apps never help you keep. The habit even has a name — <span class="highlight-link">digital hoarding</span> — and the <span class="highlight-link">attention economy</span> makes saving effortless while quietly ensuring you never come back.
                  </span>
                </li>
                <li>
                  <span class="reason-number">2.</span>
                  <span class="reason-text">
                    Savio's whole reason to exist is the return trip: a reel-style watch mode, watched and unwatched tracking, an optional once-a-day digest, and gentle nudges about saves you haven't gotten to.
                  </span>
                </li>
                <li>
                  <span class="reason-number">3.</span>
                  <span class="reason-text">
                    It's 100% private by default and free to download ($0), on <strong>iOS and Android.</strong>
                  </span>
                </li>
              </ol>
            </div>

            <div class="quote-card">
              <p class="quote-text">"Saving is easy. <span class="highlight-word">Returning</span> is the hard part — so we built the entire app around the return."</p>
              <div class="quote-meta">~ The Savio team at Rovae · About the founders</div>
            </div>
          </div>
        </section>

        <section class="section team-section" id="testimonials">
          <div class="team-header">
            <span class="eyebrow eyebrow-dark">THE PEOPLE</span>
            <h2>Who builds Savio?</h2>
            <p>Made by Rovae, a small product studio founded in 2020 by three university classmates from Pune, India. We build the whole thing ourselves — and use Savio every day.</p>
          </div>

          <div class="team-grid">
            <article class="member-card">
              <img src="/src/assets/Team Member image-1.png" alt="Dhrumil Bhojani" />
              <div class="member-copy">
                <h3>Dhrumil Bhojani</h3>
                <p>Co-Founder · Design</p>
              </div>
            </article>

            <article class="member-card">
              <img src="/src/assets/Team Member image-2.png" alt="Chintan Kamani" />
              <div class="member-copy">
                <h3>Chintan Kamani</h3>
                <p>Co-Founder · Engineering</p>
              </div>
            </article>

            <article class="member-card">
              <img src="/src/assets/Team Member image-3.png" alt="Ravi Bhagyoday" />
              <div class="member-copy">
                <h3>Ravi Bhagyoday</h3>
                <p>Co-Founder · Growth</p>
              </div>
            </article>
          </div>

          <p class="team-footer-line">More about the team and our other work is on the <a href="/about" class="highlight-link">Rovae about page.</a></p>
        </section>

        <section class="cta-strip" id="download">
          <div class="cta-card">
            <svg class="card-grid-overlay" viewBox="0 0 1062 401" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <defs>
                <mask id="cta-grid-mask" maskUnits="userSpaceOnUse">
                  <rect width="1062" height="401" fill="black"/>
                  <path d="M0 0 L0 401 M64 0 L64 401 M128 0 L128 401 M192 0 L192 401 M256 0 L256 401 M320 0 L320 401 M384 0 L384 401 M448 0 L448 401 M512 0 L512 401 M576 0 L576 401 M640 0 L640 401 M704 0 L704 401 M768 0 L768 401 M832 0 L832 401 M896 0 L896 401 M960 0 L960 401 M1024 0 L1024 401 M1062 0 L1062 401 M0 0 L1062 0 M0 64 L1062 64 M0 128 L1062 128 M0 192 L1062 192 M0 256 L1062 256 M0 320 L1062 320 M0 384 L1062 384 M0 401 L1062 401" stroke="white" stroke-opacity="0.2" stroke-width="1.5" fill="none"/>
                </mask>
                <filter id="cta-soft-blur" x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="225"/>
                </filter>
                <clipPath id="cta-grid-clip">
                  <rect width="1062" height="401" rx="24"/>
                </clipPath>
              </defs>
              <g clip-path="url(#cta-grid-clip)">
                <g mask="url(#cta-grid-mask)">
                  <ellipse cx="812.5" cy="201" rx="281.5" ry="224" fill="#FFFFFF" filter="url(#cta-soft-blur)"/>
                </g>
              </g>
            </svg>

            <div class="cta-copy-block">
              <span class="eyebrow">FREE TO DOWNLOAD</span>
              <h2>Give your saves a home.</h2>
              <p>Capture, organize, and actually come back to what matters.</p>
              <div class="cta-store-row" aria-label="App download options">
                <Image src={appStoreBadge} alt="Download on the App Store" width={134} height={40} class="cta-badge" />
                <Image src={googlePlayBadge} alt="Get it on Google Play" width={134} height={40} class="cta-badge" />
              </div>
            </div>
            <Image src={heroPhoneMockup} alt="Savio hand-held phone mockup" class="cta-phone" />
          </div>
        </section>
      </main>

      <footer class="site-footer" id="app">
        <div class="footer-inner">
          <div class="footer-brand">
            <img src="/savio-logo.svg" alt="Savio logo" />
          </div>

          <nav class="footer-nav" aria-label="Footer navigation">
            <a href="#features">Features</a>
            <a href="#how-it-works">How it works</a>
            <a href="#app">App</a>
            <a href="#testimonials">Testimonials</a>
          </nav>
        </div>
      </footer>
    </div>

    <script>
      const hamburger = document.querySelector('.hamburger-btn');
      const menu = document.querySelector('.mobile-menu');

      if (hamburger && menu) {
        hamburger.addEventListener('click', () => {
          const isOpen = !menu.hidden;
          menu.hidden = isOpen;
          hamburger.setAttribute('aria-expanded', String(!isOpen));
        });

        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            menu.hidden = true;
            hamburger.setAttribute('aria-expanded', 'false');
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --savio-orange: #ff4800;
    --text-primary: #231f20;
    --text-60: rgba(35, 31, 32, 0.6);
    --text-70: rgba(35, 31, 32, 0.7);
    --text-80: rgba(35, 31, 32, 0.8);
    --white: #ffffff;
    --soft-gray: #f4f4f4;
    --soft-peach: rgba(255, 199, 176, 0.4);
    --soft-peach-strong: rgba(255, 199, 176, 0.6);
    --card-border: rgba(35, 31, 32, 0.1);
    --card-border-strong: rgba(35, 31, 32, 0.2);
    --shadow-soft: rgba(255, 72, 0, 0.2);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    min-height: 100vh;
    background: #ffffff;
    color: var(--text-primary);
